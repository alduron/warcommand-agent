<UserControl x:Class="WarCommand.Agent.Overlay.BoardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WarCommand.Agent.Overlay"
        Background="{DynamicResource Ground}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WarCommand.Agent.Overlay;component/Theme/OverlayTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:RoleBrushConverter x:Key="RoleBrush" />
            <local:SeverityBrushConverter x:Key="SeverityBrush" />
            <local:NotBoolToVisibilityConverter x:Key="NotBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- One row, the anatomy from docs/design/mocks/OverlayRows.dc.html. Every colour comes
                 from the accent, so an urgent edge can never sit beside a green digit. -->
            <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:BoardRowViewModel}">
                <!-- Entrance wraps the row rather than being the row: RowRoot's Opacity carries the
                     .4 wash of somebody else's claim, and an animation on the same property would
                     hold that value forever. Two Borders, two jobs. -->
                <Border x:Name="Entrance" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="EntranceSlide" X="10" />
                    </Border.RenderTransform>
                <Border x:Name="RowRoot" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RowDivider}"
                        Padding="0,1,9,1" Opacity="{Binding RowOpacity}">
                    <!-- The navigation highlight lands on the REAL row. The board is not redrawn
                         inside a menu panel, so what you move through is what you are looking at. -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Transparent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HighlightGround}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                  <Grid>
                    <!--
                        The auto-cancel countdown, as a wash across the whole row rather than a bar
                        on a line of its own. A bar cost every row a line of height on a surface
                        that has to show nine of them, and the row is the thing expiring, so the row
                        is what should drain. Deliberately faint: it is ambient state, not a thing
                        to look at, and the eye is hunting the slot digit.
                    -->
                    <!-- Through SmoothProgress, not Value: the board ticks once a second, and a
                         direct binding advances the wash in one second steps on every open row at
                         once. Ambient state must not twitch. -->
                    <ProgressBar x:Name="TimeWashFill" Minimum="0" Maximum="1"
                                 local:SmoothProgress.Value="{Binding CountdownFraction}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Rectangle x:Name="PART_Track" Fill="{StaticResource Transparent}" />
                                    <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                               Fill="{StaticResource TimeWash}" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <DockPanel LastChildFill="True">
                        <Rectangle x:Name="EdgeBar" DockPanel.Dock="Left" Width="2" Margin="0,0,8,0"
                                   Fill="{StaticResource Transparent}" />
                        <TextBlock x:Name="Slot" DockPanel.Dock="Left" Width="22" TextAlignment="Center"
                                   Text="{Binding SlotDisplay}" FontFamily="{StaticResource CondensedFont}"
                                   FontWeight="Bold" FontSize="{StaticResource SlotSize}"
                                   Foreground="{StaticResource Ink}" Margin="0,0,8,0" />
                        <!--
                            TWO LINES AND A CHIP BAND, on one grid, from OverlayTwoPoint.dc.html.
                            The board has to show NINE of these, so two lines is the budget and
                            every field earns its slot inside it.

                            Nothing flows. Each slot has one meaning and one address on every row:
                            type at 0 and callsign at 0, coordinate one and coordinate two both at
                            108, state word at the right of line 1, leg and ticket at the right of
                            line 2. The chip band is the only thing that grows, and it grows
                            downward, so it moves nothing.

                            Three faults, all the same fault, all fixed here. A flat WrapPanel let
                            PICKUP and DROPOFF flow like words. A wrapping meta line put the
                            callsign and the ticket wherever the tag count left them. Then giving
                            the dropoff, the callsign and the ticket a line each made a tagged
                            HOTDROP four lines tall, and nine of those do not fit on a screen.
                        -->
                        <StackPanel>
                            <!-- Line 1. The identity column is fixed, so the coordinate starts at
                                 the same x on every row of the board whatever the type is. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TypeColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource PointTieWidth}" />
                                    <ColumnDefinition Width="{StaticResource CoordColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center" ClipToBounds="True">
                                    <Canvas Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"
                                            SnapsToDevicePixels="True">
                                        <Canvas.LayoutTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </Canvas.LayoutTransform>
                                        <Canvas.RenderTransform>
                                            <TranslateTransform Y="{StaticResource GlyphCapNudge}" />
                                        </Canvas.RenderTransform>
                                        <Path Data="{Binding RoleGlyphFirst}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stroke="{Binding RoleBrushKey, Converter={StaticResource RoleBrush}}" />
                                        <Path Data="{Binding RoleGlyphSecond}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stroke="{Binding RoleBrushKey, Converter={StaticResource RoleBrush}}" />
                                    </Canvas>
                                    <TextBlock Style="{StaticResource Up}"
                                               FontSize="{StaticResource LabelSize}"
                                               VerticalAlignment="Center"
                                               Text="{Binding TypeAndQualifier}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Style="{StaticResource Mono}"
                                           VerticalAlignment="Center"
                                           Text="{Binding CoordinatesDisplay}" />

                                <TextBlock x:Name="StateWord" Grid.Column="3"
                                           Style="{StaticResource Up}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding StateWord}"
                                           Foreground="{StaticResource Ink}" Margin="8,0,0,0" />
                            </Grid>

                            <!--
                                Line 2, always drawn and always the same shape. The second point,
                                the gun bracket and nothing else share the coordinate column, and
                                they can never collide: every type that computes a bracket carries
                                a single point. The callsign takes the identity column under the
                                type; the leg and the ticket take the right.

                                This line is where the height came back. The dropoff, the callsign
                                and the ticket each had a line of their own, which made a tagged
                                HOTDROP four lines tall, and nine of those do not fit on a screen.
                                The DROPOFF caption went with them: the arrow in the tie column
                                says the same thing in 8 units instead of 100.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TypeColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource PointTieWidth}" />
                                    <ColumnDefinition Width="{StaticResource CoordColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource DimMono}"
                                           FontSize="{StaticResource SmallSize}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Requester}" />

                                <Path Grid.Column="1" Data="M 3.5,1 L 3.5,9 L 8,9 M 6,7 L 8,9 L 6,11"
                                      Stroke="{StaticResource Edge}" StrokeThickness="1"
                                      Width="8" Height="18" VerticalAlignment="Center"
                                      Visibility="{Binding SecondPointDisplay,
                                                           Converter={StaticResource NullToVisibility}}" />

                                <TextBlock Grid.Column="2" Style="{StaticResource DimMono}"
                                           VerticalAlignment="Center"
                                           Text="{Binding SecondPointDisplay}" />

                                <!-- The opening bracket, gunners only, in the same slot. Empty for
                                     everybody else, and never beside a second point. -->
                                <TextBlock x:Name="SolutionLine" Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Squad}"
                                           Text="{Binding SolutionDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DimMono}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SolutionDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="3" Style="{StaticResource DimMono}"
                                           FontSize="{StaticResource SmallSize}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Text="{Binding LegDisplay}" />

                                <TextBlock Grid.Column="4" Style="{StaticResource DimMono}"
                                           FontSize="{StaticResource SmallSize}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Text="{Binding TicketCode}" />
                            </Grid>

                            <!--
                                The chip band. Everything that qualifies the ask and varies in
                                number: the tags, then RETRY. Its own full-width line so it grows
                                DOWNWARD and moves nothing, and zero height when there is none,
                                which is most rows and every bare HOTDROP.
                            -->
                            <ItemsControl x:Name="TagLine" ItemsSource="{Binding Chips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                                Margin="0,0,3,1" Padding="3,0,3,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Transparent}">
                                            <TextBlock Style="{StaticResource Up}"
                                                       FontSize="{StaticResource ChipSize}"
                                                       LineHeight="{StaticResource ChipLineHeight}"
                                                       Foreground="{StaticResource Dim}"
                                                       Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                  </Grid>
                </Border>
                </Border>
                <DataTemplate.Triggers>
                    <!-- A new row settles in rather than appearing under the reader's eye. 140 ms,
                         opacity and a 10 px slide from the anchored edge, and nothing else: the
                         slot digit, the ordering and the state colour never move or fade, because
                         those are what the 400 ms glance is actually reading. -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Entrance"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetName="EntranceSlide"
                                                 Storyboard.TargetProperty="X"
                                                 To="0" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!-- OverlayRows.dc.html: the expiring digit carries a 10 px white glow. -->
                    <DataTrigger Binding="{Binding HasCountdown}" Value="True">
                        <Setter TargetName="Slot" Property="Effect" Value="{StaticResource SlotGlow}" />
                    </DataTrigger>

                    <!-- 06-overlay-ux.md: "Slot digit pulses at 1 Hz. The only animation in the
                         product." At most one digit pulses board-wide, which BoardView enforces by
                         setting Pulses on exactly one row. -->
                    <DataTrigger Binding="{Binding Pulses}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="SlotPulse">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Slot"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.35" Duration="0:0:0.5"
                                                     AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="SlotPulse" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Accent}" Value="Urgent">
                        <Setter TargetName="EdgeBar" Property="Fill" Value="{StaticResource Urgent}" />
                        <Setter TargetName="StateWord" Property="Foreground" Value="{StaticResource Urgent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="Mine">
                        <Setter TargetName="EdgeBar" Property="Fill" Value="{StaticResource Yours}" />
                        <Setter TargetName="Slot" Property="Foreground" Value="{StaticResource Yours}" />
                        <Setter TargetName="StateWord" Property="Foreground" Value="{StaticResource Yours}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="Warned">
                        <Setter TargetName="EdgeBar" Property="Fill" Value="{StaticResource Warn}" />
                        <Setter TargetName="Slot" Property="Foreground" Value="{StaticResource Warn}" />
                        <Setter TargetName="StateWord" Property="Foreground" Value="{StaticResource Warn}" />
                        <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource TakenWash}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="Muted">
                        <Setter TargetName="Slot" Property="Foreground" Value="{StaticResource Dim}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The requester's own strip: ticket, type, point, then who has it. -->
            <DataTemplate x:Key="StripRowTemplate" DataType="{x:Type local:BoardRowViewModel}">
                <Border x:Name="StripRoot" Background="{DynamicResource PanelGround}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1,0,1,1" Padding="0,4,9,4">
                    <DockPanel LastChildFill="True">
                        <!--
                            06-overlay-ux.md: green left edge for the row you took, amber for the
                            row taken off you. One coloured word at the far right was the whole
                            signal, and at a glance across a dim strip it read as no signal at all.
                        -->
                        <Rectangle x:Name="StripEdge" DockPanel.Dock="Left" Width="2" Margin="0,0,7,0"
                                   Fill="{StaticResource Transparent}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StripTicket" Grid.Column="0" VerticalAlignment="Center"
                                       Style="{StaticResource DimMono}" Text="{Binding TicketCode}" />
                            <TextBlock x:Name="StripType" Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource Up}" Foreground="{StaticResource Dim}"
                                       Margin="10,0,0,0" Text="{Binding TypeAndQualifier}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource DimMono}" Margin="10,0,0,0"
                                       Text="{Binding CoordinatesDisplay}" />
                            <!--
                                The two halves of a claim do not look alike. Green [YOU] is a job
                                you took; amber is a request of yours somebody else took, which is
                                news. One colour for both was the bug: they read as the same event.
                            -->
                            <TextBlock x:Name="StripState" Grid.Column="3" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="10,0,0,0" Text="{Binding StateWord}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Up}">
                                        <Setter Property="Foreground" Value="{StaticResource Squad}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Accent}" Value="Mine">
                                                <Setter Property="Foreground" Value="{StaticResource Yours}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Accent}" Value="Warned">
                                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <!-- Green: a job you are expected to act on. The edge, the ticket and the type
                         all carry it, so the row reads as yours before the eye reaches the word. -->
                    <DataTrigger Binding="{Binding Accent}" Value="Mine">
                        <Setter TargetName="StripEdge" Property="Fill" Value="{StaticResource Yours}" />
                        <Setter TargetName="StripTicket" Property="Foreground" Value="{StaticResource Yours}" />
                        <Setter TargetName="StripType" Property="Foreground" Value="{StaticResource Yours}" />
                    </DataTrigger>
                    <!-- Amber: somebody took your request, so you are waiting on them. Same wash
                         the board row uses for a taken row, so the two agree. -->
                    <DataTrigger Binding="{Binding Accent}" Value="Warned">
                        <Setter TargetName="StripEdge" Property="Fill" Value="{StaticResource Warn}" />
                        <Setter TargetName="StripTicket" Property="Foreground" Value="{StaticResource Warn}" />
                        <Setter TargetName="StripType" Property="Foreground" Value="{StaticResource Warn}" />
                        <Setter TargetName="StripRoot" Property="Background" Value="{StaticResource TakenWash}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0" Margin="0,14,0,0">
            <StackPanel x:Name="PanelStack" Width="{StaticResource PanelWidth}" HorizontalAlignment="Center">

                <!-- Panel. Header, rows, overflow. -->
                <Border x:Name="PanelBorder" Background="{DynamicResource PanelGround}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1">
                    <StackPanel>
                        <Border Padding="9,5" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HeaderTitle" Grid.Column="0" Style="{StaticResource Up}"
                                               FontSize="{StaticResource SmallSize}" Foreground="{StaticResource Dim}"
                                               Text="WARCOMMAND" />
                                    <TextBlock x:Name="HeaderCount" Grid.Column="1" Style="{StaticResource Up}"
                                               FontSize="{StaticResource SmallSize}" Foreground="{StaticResource Dim}"
                                               Margin="8,0,0,0" />
                                    <TextBlock x:Name="HeaderMap" Grid.Column="2" Style="{StaticResource Up}"
                                               FontSize="{StaticResource SmallSize}" Foreground="{StaticResource Dim}"
                                               Margin="8,0,0,0" />
                                    <!-- The invite code is the one thing on this bar somebody reads
                                         out loud, so it is the largest text on it and carries no
                                         label: six digits in the corner are not mistakable for
                                         anything else. -->
                                    <TextBlock x:Name="HeaderRight" Grid.Column="3" Style="{StaticResource Up}"
                                               FontSize="{StaticResource InviteSize}" FontWeight="Bold"
                                               Foreground="{StaticResource Squad}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                                <!--
                                    The hint sizes first and the roles take what is left. The other
                                    way round, fourteen subscribed roles ate the row and the hint
                                    was clipped mid-word, which is worst exactly when it matters:
                                    NO PTT KEY TRAY > SETTINGS is the line that says why nothing
                                    responds to the keyboard.
                                -->
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl x:Name="HeaderRoles" Grid.Column="0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- Wraps, so a full role set costs a second line
                                                     rather than the hint beside it. -->
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,7,0"
                                                            ToolTip="{Binding Display}">
                                                    <!-- 24x24 because that is the glyph's own box.
                                                         A smaller canvas reserves less than the ink
                                                         and the icon sits low beside its label. -->
                                                    <Canvas Width="24" Height="24" Margin="0,0,4,0"
                                                            VerticalAlignment="Center" SnapsToDevicePixels="True">
                                                        <Canvas.LayoutTransform>
                                                            <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                                        </Canvas.LayoutTransform>
                                                        <Path Data="{Binding RoleGlyphFirst}" StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Stroke="{Binding RoleBrushKey, Converter={StaticResource RoleBrush}}" />
                                                        <Path Data="{Binding RoleGlyphSecond}" StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Stroke="{Binding RoleBrushKey, Converter={StaticResource RoleBrush}}" />
                                                    </Canvas>
                                                    <!--
                                                        Glyph only, no label. These are the
                                                        viewer's OWN roles, which they chose and
                                                        which change only when they change them,
                                                        so the name is a word they already know.
                                                        Safe here and only here: all 14 role icons
                                                        are unique, checked by
                                                        RoleGlyphCentringTests. A board ROW cannot
                                                        do this, because its icon is the role's and
                                                        eleven roles serve several types.
                                                    -->
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="HeaderHint" Grid.Column="1" Style="{StaticResource Up}"
                                               FontSize="{StaticResource SmallSize}" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Bottom"
                                               HorizontalAlignment="Right" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            Status. Its own line, because the header's right cell is the JOIN CODE
                            and a status word written there covered the six digits somebody was
                            about to read out loud.

                            One line, always. Items sit side by side, worst first, separated by a
                            hairline, and anything past the third becomes a +N rather than wrapping:
                            a strip that grows pushes every row of the board down, and the board is
                            the thing being read. Collapsed entirely when nothing stands, so a
                            healthy panel pays nothing for it.
                        -->
                        <Border x:Name="StatusStrip" Padding="9,0" MinHeight="21"
                                Visibility="Collapsed"
                                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="StatusItems" Grid.Column="0"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Never a WrapPanel. A second line here moves every
                                                 row on the board down by one. -->
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- The divider belongs to the item and hides on
                                                     the first one, so the strip needs no separator
                                                     pass and never draws a leading rule. -->
                                                <Border Width="1" Height="9" Margin="9,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource RowDivider}"
                                                        Visibility="{Binding IsFirst,
                                                            Converter={StaticResource NotBoolToVisibility}}" />
                                                <!-- 5px, the smallest dot that still reads as a
                                                     colour rather than as punctuation. Drawn rather
                                                     than typed: a bullet glyph sits differently in
                                                     every fallback face on the list. -->
                                                <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding Severity,
                                                            Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock FontFamily="{StaticResource CondensedFont}"
                                                           FontSize="{StaticResource SmallSize}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Severity,
                                                              Converter={StaticResource SeverityBrush}}"
                                                           Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- What did not fit, as a count. The same idiom as the roster's
                                     chips and the board's own overflow line. -->
                                <TextBlock x:Name="StatusMore" Grid.Column="1"
                                           FontFamily="{StaticResource CondensedFont}"
                                           FontSize="{StaticResource SmallSize}"
                                           Foreground="{StaticResource Dim}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Border>

                        <!--
                            The menu. It draws its own digits, which is the whole reason the hotkey
                            surface is four bindings and not twelve: a chord draws nothing, a menu
                            teaches itself while you use it.
                        -->
                        <Border x:Name="MenuPanel" Padding="9,7" Visibility="Collapsed"
                                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                                Background="{StaticResource TakenWash}">
                            <StackPanel>
                                <TextBlock x:Name="MenuTitle" Style="{StaticResource Up}"
                                           FontSize="{StaticResource LabelSize}"
                                           Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="MenuTyped" Style="{StaticResource Mono}"
                                           FontSize="{StaticResource SlotSize}"
                                           Foreground="{StaticResource Yours}" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="MenuLegend" Style="{StaticResource Up}"
                                           FontSize="{StaticResource LabelSize}"
                                           Foreground="{StaticResource Dim}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <ItemsControl x:Name="MenuOptions" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,1">
                                                <!-- The whole row carries the highlight. A caret
                                                     alone was too small to find under fire. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource HighlightGround}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- The wheel's position. Fixed column so the eye
                                                     finds it in the same place on every level. -->
                                                <TextBlock Grid.Column="0" Style="{StaticResource Up}"
                                                           FontSize="{StaticResource LabelSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Yours}"
                                                           Text="{Binding Caret}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Up}"
                                                           FontSize="{StaticResource LabelSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Squad}"
                                                           Text="{Binding DigitDisplay}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Up}"
                                                               FontSize="{StaticResource LabelSize}"
                                                               Foreground="{StaticResource Ink}"
                                                               Text="{Binding Label}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- Toggled on. Several chosen must read as
                                                         several, not as the first one. -->
                                                    <TextBlock Style="{StaticResource Up}"
                                                               FontSize="{StaticResource LabelSize}"
                                                               Foreground="{StaticResource Yours}"
                                                               Margin="6,0,0,0"
                                                               Text="{Binding Mark}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="RowsList" ItemTemplate="{StaticResource RowTemplate}" />

                        <!-- The tail of the home list, which is MORE. It sits UNDER the rows
                             because that is where it is in the list: the order on screen has to be
                             the order the highlight moves through, or moving reads as teleporting. -->
                        <Border x:Name="MenuFooter" Padding="9,5" Visibility="Collapsed">
                            <ItemsControl x:Name="MenuTrailing"
                                          ItemTemplate="{Binding ItemTemplate, ElementName=MenuOptions}" />
                        </Border>

                        <Border x:Name="OverflowRow" Padding="9,5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <!-- Which nine of how many. Absent on a board that fits. -->
                                <TextBlock x:Name="PageText" Style="{StaticResource Up}"
                                           Foreground="{StaticResource Dim}" Margin="0,0,16,0" />
                                <TextBlock x:Name="OverflowText" Style="{StaticResource Up}"
                                           Foreground="{StaticResource Dim}" />
                                <TextBlock x:Name="OverflowUrgentText" Style="{StaticResource Up}"
                                           Foreground="{StaticResource Urgent}" Margin="16,0,0,0" />
                                <!-- Everything somebody else is already on, as one line. Enough to
                                     stop a second call on the same target, with nothing to read. -->
                                <TextBlock x:Name="InProgressText" Style="{StaticResource Up}"
                                           Foreground="{StaticResource Dim}" Margin="16,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- No deployment, or an unreachable API. One line, never a paragraph. -->
                        <Border x:Name="EmptyState" Padding="9,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="EmptyStateTitle" Style="{StaticResource Up}"
                                           FontSize="{StaticResource LabelSize}" />
                                <TextBlock x:Name="EmptyStateHint" Style="{StaticResource DimMono}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ACTIVE: the rows this viewer is one half of, what they took and what they
                     asked for that somebody took. Foot of the board, because the top belongs to
                     work that still needs a taker. -->
                <StackPanel x:Name="YoursSection" Visibility="Collapsed">
                    <Border Padding="9,5,9,2">
                        <TextBlock x:Name="YoursLabel" Style="{StaticResource Up}"
                                   Foreground="{StaticResource Dim}" Text="ACTIVE" />
                    </Border>
                    <ItemsControl x:Name="SecondaryList" ItemTemplate="{StaticResource StripRowTemplate}" />
                </StackPanel>

                <!-- RANGE: a section of the board, not a line inside a menu. The numbers used
                     to be squeezed into the menu's one typed-text field, so they were clipped and
                     they only existed while the key was held: the crew could not read what they
                     were about to dial. It lives here for as long as an origin is set. -->
                <StackPanel x:Name="ArtillerySection" Visibility="Collapsed">
                    <Border Padding="9,5,9,2">
                        <TextBlock x:Name="ArtilleryLabel" Style="{StaticResource Up}"
                                   Foreground="{StaticResource Dim}" Text="RANGE" />
                    </Border>
                    <Border Padding="9,0,9,6">
                        <StackPanel>
                            <TextBlock x:Name="ArtilleryGun" Style="{StaticResource Mono}"
                                       FontSize="{StaticResource LabelSize}"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ArtilleryTarget" Style="{StaticResource Mono}"
                                       FontSize="{StaticResource LabelSize}"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />

                            <!-- The range itself, in the mode's own terms. It turns red the
                                 moment the shot is outside what that weapon can reach. -->
                            <TextBlock x:Name="ArtilleryRange" Style="{StaticResource Mono}"
                                       FontSize="{StaticResource SlotSize}"
                                       Foreground="{StaticResource Ink}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />

                            <!-- The numbers the crew dials. Big, on their own line, wrapping rather
                                 than trimming: a clipped elevation is a round on the wrong grid. -->
                            <TextBlock x:Name="ArtilleryBracket" Style="{StaticResource Mono}"
                                       FontSize="{StaticResource SlotSize}"
                                       Foreground="{StaticResource Yours}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ArtilleryNote" Style="{StaticResource Up}"
                                       FontSize="{StaticResource LabelSize}"
                                       Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="DevPanel" Margin="0,10,0,0" Padding="9,6" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SimulatePttButton" Content="SIMULATE PTT" Padding="8,2"
                                Background="{StaticResource Transparent}" Foreground="{StaticResource Ink}"
                                BorderBrush="{StaticResource BoxEdge}" FontFamily="{StaticResource CondensedFont}"
                                FontWeight="SemiBold" Click="OnSimulatePttClick" />
                        <TextBlock x:Name="SimulatedPointText" Style="{StaticResource Mono}"
                                   Foreground="{StaticResource Yours}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource Mono}" FontSize="9"
                           Foreground="{StaticResource Dim}" Opacity="0.6" Margin="0,10,0,14"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
