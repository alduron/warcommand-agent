<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Underscored test names are the convention here. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
    <!-- Vosk's build targets are private assets and do not flow through the project reference, so
         libvosk.dll never reaches this output without naming the package here. Without it the
         recorded-buffer harness cannot run even when a model is installed. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The tray loads its icons from the output directory, so the menu test needs them. -->
  <ItemGroup>
    <None Include="..\WarCommand.Agent\Resources\Icons\*.ico"
          Link="Resources\Icons\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The recorded-buffer corpus and its manifest. The harness reads them from the output
       directory, so adding a recording is one wav plus one manifest row and no code change. -->
  <ItemGroup>
    <None Update="Speech\buffers\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarCommand.Agent.Core\WarCommand.Agent.Core.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Overlay\WarCommand.Agent.Overlay.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Input\WarCommand.Agent.Input.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Speech\WarCommand.Agent.Speech.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Capture\WarCommand.Agent.Capture.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Client\WarCommand.Agent.Client.csproj" />
    <ProjectReference Include="..\WarCommand.Agent\WarCommand.Agent.csproj" />
  </ItemGroup>

</Project>
