<Window x:Class="WarCommand.Agent.Tray.PairingCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up WarCommand"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}"
        FontFamily="{DynamicResource CondensedFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- The same dark ground as the agent window. Built from docs/design/mocks/agent/Pairing. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WarCommand.Agent.Overlay;component/Theme/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="Enter the pairing code" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource Ink}" />
        <TextBlock Text="From the web, while signed in" Style="{StaticResource FieldCaption}"
                   Margin="0,4,0,16" />

        <TextBox x:Name="CodeBox" Height="36" Padding="12,0" VerticalContentAlignment="Center"
                 FontFamily="{StaticResource MonoFont}" FontSize="16"
                 CharacterCasing="Upper" MaxLength="16" KeyDown="OnCodeKeyDown" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Urgent}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCEL" MinWidth="92" Click="OnCancel" />
            <Button x:Name="PairButton" Content="PAIR" MinWidth="92" Margin="10,0,0,0"
                    Background="{StaticResource Squad}" BorderBrush="{StaticResource Squad}"
                    Foreground="{StaticResource Ground}" Click="OnPair" />
        </StackPanel>
    </StackPanel>
</Window>
