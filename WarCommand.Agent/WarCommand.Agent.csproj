<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WarCommand.Agent.Core\WarCommand.Agent.Core.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Client\WarCommand.Agent.Client.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Overlay\WarCommand.Agent.Overlay.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Input\WarCommand.Agent.Input.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Speech\WarCommand.Agent.Speech.csproj" />
    <ProjectReference Include="..\WarCommand.Agent.Capture\WarCommand.Agent.Capture.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon lives in WinForms; there is no WPF tray icon control. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- The process users see in Task Manager, the name on the exe, and the name the installer
         launches. The project and its namespaces stay WarCommand.Agent; only the artefact is
         renamed, because "WarCommand.Agent.exe" reads like a service somebody else installed. -->
    <AssemblyName>WarCommand</AssemblyName>
    <RootNamespace>WarCommand.Agent</RootNamespace>

    <!-- NOT one of the three tray icons. Field colour means connection state and the exe's icon is
         stamped at build time, so a status colour there would be permanently wrong. -->
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WarCommand.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Icons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms swaps the SDK's implicit-usings set to the WinForms one, which drops
         System.IO. Restore it rather than hand-adding "using System.IO;" to every file that
         already relied on it being implicit. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
