<Window x:Class="WarCommand.Agent.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:WarCommand.Agent.Overlay;assembly=WarCommand.Agent.Overlay"
        Title="WarCommand"
        Width="760" Height="760" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}"
        FontFamily="{DynamicResource CondensedFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Built from docs/design/mocks/agent. Every measurement is in that set's Anatomy artboard:
         24px body gutter, 22 between groups, cards padded 18 with rows flush to both card edges. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WarCommand.Agent.Overlay;component/Theme/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,1,0,0" Padding="24,0" Height="56">
            <Grid>
                <TextBlock x:Name="SavedNote" Style="{StaticResource FootNote}"
                           HorizontalAlignment="Left" Text="Saves as you change it" />
                <Button Content="CLOSE" Click="OnClose" MinWidth="92" HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs">

            <TabItem Header="BOARD">
                <overlay:BoardView x:Name="Board" />
            </TabItem>

            <TabItem Header="AUDIO">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <StackPanel MaxWidth="720">

                        <TextBlock Text="DEVICES" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Input device" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <ComboBox x:Name="InputDevice" Grid.Column="1" Width="280"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Output device" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Separate from input on purpose"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <ComboBox x:Name="OutputDevice" Grid.Column="1" Width="280"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Master volume" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Slider x:Name="MasterVolume" Width="240" Minimum="0" Maximum="1"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="OnDirty" />
                                            <TextBlock x:Name="MasterVolumeValue" Margin="12,0,0,0"
                                                       Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EVENT SOUNDS" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <UniformGrid Columns="2" Margin="0,14">
                                <CheckBox x:Name="SoundBoardEmpty" Style="{StaticResource SwitchLabel}"
                                          Content="Board went from empty" Margin="0,7,24,7" Click="OnDirty" />
                                <CheckBox x:Name="SoundNewUrgent" Style="{StaticResource SwitchLabel}"
                                          Content="New urgent" Margin="0,7" Click="OnDirty" />
                                <CheckBox x:Name="SoundYourClaimed" Style="{StaticResource SwitchLabel}"
                                          Content="Your request claimed" Margin="0,7,24,7" Click="OnDirty" />
                                <CheckBox x:Name="SoundClaimOk" Style="{StaticResource SwitchLabel}"
                                          Content="Claim succeeded" Margin="0,7" Click="OnDirty" />
                                <CheckBox x:Name="SoundClaimLost" Style="{StaticResource SwitchLabel}"
                                          Content="Claim lost the race" Margin="0,7,24,7" Click="OnDirty" />
                                <CheckBox x:Name="SoundAll" Style="{StaticResource SwitchLabel}"
                                          Content="All sound off" Margin="0,7" Click="OnDirty" />
                            </UniformGrid>
                        </Border>

                        <Border x:Name="AudioNoticeBox" Style="{StaticResource Notice}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="16" Height="16" Stretch="None"
                                      Stroke="{StaticResource Warn}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Top" Margin="0,1,11,0"
                                      Data="M 8,2.5 L 14,13.5 L 2,13.5 Z M 8,6.6 L 8,9.8 M 8,11.5 L 8,11.6" />
                                <TextBlock x:Name="AudioNotice" Grid.Column="1"
                                           Style="{StaticResource NoticeText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="KEYBINDS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <StackPanel MaxWidth="720">

                        <TextBlock Text="BINDINGS" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="Bindings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FieldRowCompact}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                                Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Action}"
                                                                   Style="{StaticResource FieldLabel}"
                                                                   FontSize="14" />
                                                        <TextBlock Text="{Binding Note}"
                                                                   Style="{StaticResource FieldCaption}"
                                                                   Visibility="{Binding NoteVisibility}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource KeyPill}">
                                                        <TextBlock x:Name="ChordText" Text="{Binding Chord}"
                                                                   Style="{StaticResource KeyPillText}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBound}" Value="False">
                                                    <Setter TargetName="ChordText" Property="Foreground"
                                                            Value="{StaticResource Dim}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Reset to defaults" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Restores every chord above"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="RESET" Click="OnResetBindings"
                                                MinWidth="92" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Notice}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="16" Height="16" Stretch="None"
                                      Stroke="{StaticResource Warn}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Top" Margin="0,1,11,0"
                                      Data="M 8,2.5 L 14,13.5 L 2,13.5 Z M 8,6.6 L 8,9.8 M 8,11.5 L 8,11.6" />
                                <TextBlock Grid.Column="1" Style="{StaticResource NoticeText}"
                                           Text="A clash with the game cannot be detected. Test the key in Wardogs first." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SPEECH">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <StackPanel MaxWidth="720">

                        <TextBlock Text="RECOGNIZER" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Read-only at M1" Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <TextBlock x:Name="RecognizerName" Grid.Column="1"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Confidence floor" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Headset quality varies enormously"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Slider x:Name="ConfidenceFloor" Width="240" Minimum="0.3" Maximum="0.95"
                                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="OnDirty" />
                                            <TextBlock x:Name="ConfidenceValue" Margin="12,0,0,0"
                                                       Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="FEEDBACK" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Recognized-text feedback"
                                                   Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="Shows what was heard for every utterance"
                                                   Style="{StaticResource FieldCaption}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowRecognizedText" Grid.Column="1"
                                              Style="{StaticResource Switch}" Click="OnDirty" />
                                </Grid>
                            </Border>
                        </Border>

                        <Border Style="{StaticResource Notice}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="16" Height="16" Stretch="None"
                                      Stroke="{StaticResource Warn}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Top" Margin="0,1,11,0"
                                      Data="M 8,2.5 L 14,13.5 L 2,13.5 Z M 8,6.6 L 8,9.8 M 8,11.5 L 8,11.6" />
                                <TextBlock Grid.Column="1" Style="{StaticResource NoticeText}"
                                           Text="Audio never leaves this machine. Nothing is written to disk." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="OVERLAY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <StackPanel MaxWidth="720">

                        <TextBlock Text="PLACEMENT" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Draw over the game"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Borderless Windowed only. Off leaves second-screen mode"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <CheckBox x:Name="OverlayEnabled" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Click="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Display" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Used when no game is running. With a game up it follows the game"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <ComboBox x:Name="DisplayBox" Grid.Column="1" Width="280"
                                                  DisplayMemberPath="Label"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Anchor position" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <ComboBox x:Name="AnchorBox" Grid.Column="1" Width="280"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Width scale" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Panel width, in pixels"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Slider x:Name="WidthPx" Width="240" Minimum="300" Maximum="560"
                                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="OnDirty" />
                                            <TextBlock x:Name="WidthValue" Margin="12,0,0,0"
                                                       Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <ComboBox x:Name="OverlayOpacityBox" Grid.Column="1" Width="280"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Colourblind-safe theme"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Swaps the green to #4C9AFF. Urgent keeps its red"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ColourblindSafe" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Click="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Draw when no game is running"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="On until Wardogs ships. Off leaves the overlay hidden until a game window appears"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ShowWithoutGame" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Click="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Second-screen mode" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="The only mode that works with exclusive fullscreen"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <CheckBox x:Name="SecondScreen" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Click="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="When the game is not focused"
                                                       Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <ComboBox x:Name="WhenUnfocused" Grid.Column="1" Width="280"
                                                  VerticalAlignment="Center" SelectionChanged="OnDirty" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Auto-copy on claim" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="Clobbers whatever is on your clipboard"
                                                       Style="{StaticResource FieldCaption}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AutoCopyOnClaim" Grid.Column="1"
                                                  Style="{StaticResource Switch}" Click="OnDirty" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRIVACY" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Screen capture" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="Opt-in, off by default. Frames never leave this machine"
                                                   Style="{StaticResource FieldCaption}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ScreenCapture" Grid.Column="1"
                                              Style="{StaticResource Switch}" Click="OnDirty" />
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
