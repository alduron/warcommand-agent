#!/usr/bin/env bash
# Runs the build and test gates and refuses the push if either fails, then tags main so the push
# actually ships. release.yml repeats the gates on a tag, but that is the release, not a gate on
# main. RELEASE, not Debug: Directory.Build.props sets TreatWarningsAsErrors, so a Debug-only check
# misses the analyzer gate that CI applies.
#
# WHAT IS VERIFIED: the COMMIT being pushed, checked out into a throwaway `git worktree`, never the
# working tree. A push carries commits; the working tree is a different thing that merely resembles
# them. Verifying the tree meant a file that was never `git add`ed passed here and failed
# release.yml, and it meant another session's unrelated in-flight edit turned a green commit red.
# Both are the same defect and this is the fix. The worktree is removed on success, on failure and
# on interrupt.
#
# The agent suite reads files from OUTSIDE this repo (see UmbrellaDependencies), so the sibling
# layout is rebuilt beside the temporary checkout with directory junctions: <tmp>/contracts and
# <tmp>/warcommand-api sit beside <tmp>/warcommand-agent exactly as they do in the umbrella clone.
# A junction is a link, so cleanup NEVER recurses through one: it unlinks first, then deletes.
#
# Set SKIP_VERIFY=1 to bypass the gates, which is for a broken toolchain, never for a red step.
# Set WARCMD_VERIFY_WORKTREE=0 to run the gates against the WORKING TREE instead, which is the old
# behaviour and is for debugging this hook, never for a push you intend to keep.
# Set WARCMD_AUTOTAG=0 to push main without cutting a tag.
# The body is ONE brace group ending in `exit`, and that is load-bearing rather than style.
# Bash reads a script from its file in chunks, seeking back to just past the last command it
# parsed, so a script edited WHILE IT RUNS resumes at a stale byte offset and runs garbage. A
# parallel session touching this file mid-push produced exactly that:
#
#   .githooks/pre-push: line 18: nt.sln: command not found
#
# and the push was refused for a reason that had nothing to do with the code. A brace group is
# parsed in full before any of it runs, and the `exit` means nothing past the closing brace is
# ever read. Several sessions work in these repos at once; a gate somebody else's editor can
# break is not a gate.

{
  set -euo pipefail

  remote="${1:-origin}"
  zero="0000000000000000000000000000000000000000"

  # stdin is one "<local ref> <local sha> <remote ref> <remote sha>" line per ref being pushed.
  # Read it before anything else: the gates below take minutes and nothing else consumes it.
  main_sha=""
  main_was=""
  shas=""
  while read -r _local_ref local_sha remote_ref remote_was; do
    if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$zero" ]; then continue; fi
    if [ "$remote_ref" = "refs/heads/main" ]; then
      main_sha="$local_sha"
      main_was="$remote_was"
    fi
    case " $shas " in *" $local_sha "*) ;; *) shas="$shas $local_sha" ;; esac
  done

  root="$(git rev-parse --show-toplevel)"
  cd "$root"

  # The umbrella clone this repo sits in, or empty in a standalone clone.
  umbrella=""
  if [ -f "$root/../contracts/request-types.json" ]; then
    umbrella="$(cd "$root/.." && pwd)"
  fi

  # Every check release.yml runs, in the order it runs them.
  gates() {
    echo "pre-push: running the agent CI locally, Release."
    dotnet restore WarCommand.Agent.sln
    dotnet build WarCommand.Agent.sln -c Release --no-restore
    dotnet test WarCommand.Agent.sln -c Release --no-build
  }

  # ---------------------------------------------------------------------------------------------
  # Worktree plumbing. tmp, tree and links are everything cleanup has to undo.
  # ---------------------------------------------------------------------------------------------
  tmp=""
  tree=""
  links=""

  cleanup() {
    trap - EXIT INT TERM HUP
    if [ -z "$tmp" ]; then return 0; fi
    stuck=""
    oldifs="$IFS"
    IFS=$'\n'
    for link in $links; do
      if [ -z "$link" ]; then continue; fi
      # NEVER `rm -rf` a link: on Windows these are junctions, and recursing one deletes the real
      # sibling repo it points at. Unlink only.
      if [ -L "$link" ]; then
        rm -f "$link" 2>/dev/null || true
      elif [ -e "$link" ]; then
        rmdir "$link" 2>/dev/null || true
      fi
      if [ -e "$link" ] || [ -L "$link" ]; then stuck="$stuck $link"; fi
    done
    IFS="$oldifs"
    if [ -n "$tree" ]; then
      git worktree remove --force "$tree" >/dev/null 2>&1 || rm -rf "$tree" 2>/dev/null || true
    fi
    git worktree prune >/dev/null 2>&1 || true
    if [ -n "$stuck" ]; then
      echo "pre-push: could not unlink$stuck; leaving $tmp on disk rather than deleting through a link." >&2
    else
      rm -rf "$tmp" 2>/dev/null || true
    fi
    tmp=""
    tree=""
    links=""
  }

  # A directory junction on Windows, a symlink elsewhere. Silent no-op when the source is absent:
  # a standalone clone has no siblings, and the suite is written to degrade rather than lie.
  link_dir() {
    src="$1"
    dst="$2"
    if [ ! -d "$src" ]; then return 0; fi
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*)
        pwsh -NoProfile -NonInteractive -Command \
          "New-Item -ItemType Junction -Path '$(cygpath -w "$dst")' -Target '$(cygpath -w "$src")' | Out-Null" \
          >/dev/null
        ;;
      *)
        ln -s "$src" "$dst"
        ;;
    esac
    links="$links"$'\n'"$dst"
  }

  verify_commit() {
    sha="$1"
    tmp="$(mktemp -d)"
    trap cleanup EXIT INT TERM HUP
    tree="$tmp/warcommand-agent"
    # No -c core.autocrlf here, deliberately. The checkout must be filtered EXACTLY as this
    # machine's own checkout is, because several checks hash a file in the worktree against
    # the same file in a sibling working tree; a different filter makes them differ over line
    # endings alone. See Caveat_WarCommandContractCopiesAreComparedByteForByte.
    git worktree add --detach --quiet "$tree" "$sha"
    if [ -n "$umbrella" ]; then
      link_dir "$umbrella/contracts" "$tmp/contracts"
      link_dir "$umbrella/warcommand-api" "$tmp/warcommand-api"
    fi
    ( cd "$tree" && gates )
    cleanup
  }

  if [ "${SKIP_VERIFY:-0}" = "1" ]; then
    echo "pre-push: SKIP_VERIFY=1, not verifying." >&2
  elif [ "${WARCMD_VERIFY_WORKTREE:-1}" != "1" ]; then
    echo "pre-push: WARCMD_VERIFY_WORKTREE=0, verifying the WORKING TREE and not what is pushed." >&2
    gates
    echo "pre-push: green."
  elif [ -z "$shas" ]; then
    echo "pre-push: no commit on stdin, nothing to verify."
  else
    for sha in $shas; do
      echo "pre-push: verifying $sha in a clean worktree."
      verify_commit "$sha"
    done
    echo "pre-push: green."
  fi

  # A push to main that is not tagged reaches nobody. release.yml builds on a v* tag and nothing
  # else, so an untagged main is code that exists, passes, and that every installed agent's update
  # check correctly reports as not published. Five commits sat that way and read as a broken
  # updater. The tag is part of the push, not a thing to remember afterwards.
  if [ "${WARCMD_AUTOTAG:-1}" != "1" ] || [ -z "$main_sha" ]; then
    exit 0
  fi

  existing="$(git tag --points-at "$main_sha" --list 'v*' | head -n 1)"
  if [ -n "$existing" ]; then
    echo "pre-push: $existing already tags this commit, not cutting another."
    exit 0
  fi

  # Only when this push fast-forwards the remote. A rejected branch push would otherwise leave a
  # published release for a commit that never landed on main.
  if [ "$main_was" != "$zero" ] && ! git merge-base --is-ancestor "$main_was" "$main_sha"; then
    echo "pre-push: main is not a fast-forward, not tagging. Tag by hand once it lands." >&2
    exit 0
  fi

  last="$(git tag --list 'v*' --sort=-v:refname | head -n 1)"
  version="${last#v}"
  major="${version%%.*}"
  rest="${version#*.}"
  minor="${rest%%.*}"
  patch="${rest##*.}"

  case "$major.$minor.$patch" in
    *[!0-9.]*|*..*|.*|*.) echo "pre-push: cannot read a version out of '${last:-<no tag>}'. Tag by hand." >&2 ; exit 1 ;;
  esac

  next="v$major.$minor.$((patch + 1))"
  echo "pre-push: tagging $next so the release builds."

  git tag "$next" "$main_sha"

  # The gates just ran against this exact sha, and this nested push must not re-enter the tagger.
  if ! SKIP_VERIFY=1 WARCMD_AUTOTAG=0 git push "$remote" "refs/tags/$next"; then
    git tag -d "$next"
    echo "pre-push: pushing $next failed, tag removed. Nothing was released." >&2
    exit 1
  fi

  exit 0
}
