<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Product>WarCommand</Product>
    <Company>WarCommand</Company>
    <Authors>WarCommand</Authors>
    <Copyright>Copyright (c) WarCommand</Copyright>

    <!-- The release workflow overrides this from the git tag. The default is deliberately below
         every real release, so an untagged local build can never look newer than a published
         one: UpdateDecision refuses to offer a downgrade. -->
    <Version>0.0.0</Version>

    <!-- The SDK otherwise stamps AssemblyInformationalVersion as "0.1.0+<40 char sha>", 46
         characters. POST /v1/devices/register caps agent_version at 32, so every git-built agent
         was rejected with a 422 and could never pair. The sha is not something any surface shows
         and not something the API stores. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
